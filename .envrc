# Activate the deployment environment once per shell.
if [ -n "$E_SKIN_G1_DEPLOY_ENV" ]; then
  echo "g1_deploy env already active (open a new shell to start clean)"
else
  export E_SKIN_G1_DEPLOY_ENV=1

  _g1_deploy_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

  if [ -f "$_g1_deploy_dir/.venv/bin/activate" ]; then
    source "$_g1_deploy_dir/.venv/bin/activate"
  else
    echo "no .venv here -- run:  uv venv && uv pip install -e ."
  fi

  unset _g1_deploy_dir
fi
