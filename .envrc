# Two layers, activated in order:
#   1. pixi  -> python 3.11 + ROS Humble (rclpy; only tactile needs it)  tag: (e_skin_remote)
#   2. .venv -> pip packages, built on top of that same python           tag: (g1_deploy)
#
# Guarded: re-sourcing in the same shell is a no-op, so prompt tags and
# PATH entries do not stack up.

if [ -n "$E_SKIN_G1_DEPLOY_ENV" ]; then
  echo "g1_deploy env already active (open a new shell to start clean)"
else
  export E_SKIN_G1_DEPLOY_ENV=1

  eval "$(pixi shell-hook)"

  if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
  fi
fi
