+# ROS 2 also loads system spdlog. Mixing its ABI with the bundled headers
+# corrupts logger destruction at process exit (Livox-SDK2 issue #44).
+find_package(spdlog REQUIRED)
+target_link_libraries(${SDK_LIBRARY_STATIC} PUBLIC spdlog::spdlog)
+target_link_libraries(${SDK_LIBRARY_SHARED} PUBLIC spdlog::spdlog)
